# Copy this file to .env and fill in the values.

# Cloudflare Tunnel token — get this from:
# Cloudflare Zero Trust dashboard → Networks → Tunnels → Create a tunnel
# Set the tunnel ingress rule: https://draw.sixeleven.in → http://web:80
#
# The app itself has NO authentication. Access must be gated by a Cloudflare
# Access application on this hostname, exactly like odyssey.sixeleven.in.
CLOUDFLARE_TUNNEL_TOKEN=your_tunnel_token_here
